+	            { name = "Survival", key = "survival" } },
+	ROGUE   = { { name = "Assassination", key = "assassination" }, { name = "Combat", key = "combat" },
+	            { name = "Subtlety", key = "subtlety" } },
+	PRIEST  = { { name = "Discipline", key = "disc" }, { name = "Holy", key = "holy" },
