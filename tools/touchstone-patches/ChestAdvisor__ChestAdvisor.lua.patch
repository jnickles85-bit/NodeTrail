+--- purpose; the owner approves the wording.
+function ChestAdvisor.autoRoleWord(entry)
+	local r = type(entry) == "table" and entry.role or nil
+	if r == "HEALER" then return "healer" end
+	if r == "TANK" then return "tank" end
+	return "damage"
+end
